.page {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* 排序栏 */
.sort-bar {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.sort-item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8e8e93;
  border-radius: 8rpx;
}

.sort-item.active {
  background: #1a1a1a;
  color: #ffffff;
  font-weight: 600;
}

/* 加载 */
.loading {
  padding: 80rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #c7c7cc;
}

/* 空状态 */
.empty-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 1rpx solid var(--color-border);
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.empty-btn {
  width: 300rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 38rpx;
  border: none;
  line-height: 1;
}

.empty-btn::after {
  border: none;
}

/* 排行榜 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-border);
}

.rank-item.me {
  background: #1a1a1a;
}

.rank-number {
  width: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #c7c7cc;
  text-align: center;
  margin-right: 20rpx;
}

.rank-number.top {
  color: var(--color-accent);
}

.rank-item.me .rank-number {
  color: rgba(255, 255, 255, 0.60);
}

.rank-item.me .rank-number.top {
  color: var(--color-accent);
}

.rank-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8e8e93;
}

.rank-item.me .rank-avatar-placeholder {
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.80);
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.rank-item.me .rank-name {
  color: #ffffff;
}

.rank-tag {
  align-self: flex-start;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--color-accent);
  background: rgba(15, 110, 86, 0.10);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.rank-item.me .rank-tag {
  color: #1a1a1a;
  background: var(--color-accent);
}

.rank-value {
  flex-shrink: 0;
  text-align: right;
}

.value-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.rank-item.me .value-num {
  color: #ffffff;
}