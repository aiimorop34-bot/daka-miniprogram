.page {
  position: relative;
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* 同步状态提示 */
.sync-indicator {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 149, 0, 0.1);
  border-radius: 999rpx;
}

.sync-indicator.sync-failed {
  background: rgba(163, 45, 45, 0.1);
}

.sync-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff9500;
  animation: sync-pulse 1.4s ease-in-out infinite;
}

.sync-failed .sync-dot {
  background: var(--color-danger);
  animation: none;
}

.sync-text {
  font-size: 20rpx;
  color: #ff9500;
  font-weight: 500;
}

.sync-failed .sync-text {
  color: var(--color-danger);
}

@keyframes sync-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}

/* 计划切换器 */
.plan-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.plan-tabs ::-webkit-scrollbar {
  display: none;
}

.plan-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  background: #ffffff;
  border-radius: 999rpx;
  border: 1rpx solid #e5e5ea;
}

.plan-tab.active {
  background: #1a1a1a;
  border-color: #1a1a1a;
}

.plan-tab-name {
  font-size: 26rpx;
  color: #1a1a1a;
  max-width: 200rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan-tab.active .plan-tab-name {
  color: #ffffff;
  font-weight: 600;
}

.plan-tab-badge {
  font-size: 18rpx;
  color: var(--color-accent);
  border: 1rpx solid var(--color-accent);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.plan-tab.active .plan-tab-badge {
  color: #ffffff;
  border-color: #ffffff;
}

/* 分享海报按钮 */
.share-btn {
  width: fit-content;
  max-width: 92%;
  min-width: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  margin: 0 auto 20rpx;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  line-height: 1;
  letter-spacing: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.share-btn-text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 隐藏海报画布 */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750rpx;
  height: 1334rpx;
}

/* 加载 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  color: #c7c7cc;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1a1a1a;
  border-radius: 50%;
  animation: data-spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes data-spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #8e8e93;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #8e8e93;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #c7c7cc;
}

/* 图表卡片（热力图 + 雷达图共用） */
.chart-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 20rpx;
  border: 1rpx solid var(--color-border);
  margin-bottom: 20rpx;
}

.chart-header {
  margin-bottom: 16rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
}

.chart-subtitle {
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 4rpx;
  display: block;
}

/* 热力图画布 */
.heatmap-canvas {
  width: 100%;
  height: 340rpx;
  display: block;
}

.heatmap-detail {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.heatmap-detail-text {
  font-size: 24rpx;
  color: #8e8e93;
}

/* 雷达图画布 */
.radar-canvas {
  width: 100%;
  height: 620rpx;
  display: block;
}

.radar-note {
  margin-top: 8rpx;
  text-align: center;
}

.radar-note-text {
  font-size: 22rpx;
  color: #c7c7cc;
}

/* 趋势折线图 */
.trend-canvas {
  width: 100%;
  height: 440rpx;
  display: block;
}

.trend-hint {
  margin-top: 8rpx;
  text-align: center;
}

.trend-hint-text {
  font-size: 22rpx;
  color: #c7c7cc;
}

/* 自我对比 */
.compare-card {
  padding-bottom: 28rpx;
}

.compare-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.compare-tab {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8e8e93;
  border-radius: 8rpx;
  transition: all 0.2s ease;
}

.compare-tab.active {
  background: #ffffff;
  color: #1a1a1a;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.compare-empty {
  padding: 48rpx 0;
  text-align: center;
}

.compare-empty-text {
  font-size: 26rpx;
  color: #c7c7cc;
}

.compare-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.compare-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fafafa;
  border-radius: 14rpx;
  padding: 24rpx 20rpx;
}

.compare-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.compare-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  font-variant-numeric: tabular-nums;
}

.compare-label {
  font-size: 22rpx;
  color: #8e8e93;
}

.compare-change {
  flex-shrink: 0;
  min-width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.compare-change.up {
  color: var(--color-accent);
  background: rgba(15, 110, 86, 0.10);
}

.compare-change.down {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.10);
}

.compare-change.flat {
  color: #8e8e93;
  background: rgba(142, 142, 147, 0.10);
}

.compare-arrow {
  font-size: 24rpx;
  font-weight: 700;
}

.compare-diff {
  font-size: 24rpx;
  font-weight: 600;
}

.compare-eval {
  margin-top: 8rpx;
  background: #1a1a1a;
  border-radius: 14rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.compare-eval-emoji {
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.compare-eval-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.5;
}

/* 记录卡片 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 16rpx;
  border: 1rpx solid var(--color-border);
}

/* 日期头部 */
.record-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.record-date {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.record-delete-btn {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 4rpx 8rpx;
}

.record-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.record-meta-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.record-accuracy {
  font-size: 28rpx;
  font-weight: 600;
}

.record-accuracy.high { color: var(--color-accent); }
.record-accuracy.mid { color: #BA7517; }
.record-accuracy.low { color: var(--color-danger); }

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 6rpx;
  background: #f5f5f5;
  border-radius: 3rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.4s ease;
}

/* 板块明细 */
.subject-list {
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
}

.subject-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 14rpx 0;
}

.subject-name {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #1a1a1a;
}

.subject-count {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #8e8e93;
  font-variant-numeric: tabular-nums;
}

.subject-accuracy {
  flex-shrink: 0;
  width: 96rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

/* 正确率颜色 */
.high {
  color: var(--color-accent);
}
.mid {
  color: #ff9500;
}
.low {
  color: var(--color-danger);
}
.progress-fill.high {
  background: var(--color-accent);
}
.progress-fill.mid {
  background: #ff9500;
}
.progress-fill.low {
  background: var(--color-danger);
}

/* 底部留白 */
.bottom-spacer {
  height: 40rpx;
}
