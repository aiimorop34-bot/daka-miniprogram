.page {
  padding: 24rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* 用户信息卡片 */
.profile-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0 0 20rpx;
  background: transparent;
  border: none;
  border-radius: 50%;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #c7c7cc;
}

.avatar-uploading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #8e8e93;
  text-align: center;
}

.nickname-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
}

.nickname-input {
  min-width: 240rpx;
  max-width: 80%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 12rpx 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.profile-tip {
  margin-top: 12rpx;
  margin-bottom: 28rpx;
  font-size: 22rpx;
  color: #c7c7cc;
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 36rpx;
  line-height: 1;
  transition: all 0.2s ease;
}

.save-btn::after {
  border: none;
}

.save-btn-active {
  width: 240rpx;
  height: 72rpx;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.save-btn-active[disabled] {
  opacity: 0.6;
}

.save-btn-inactive {
  width: auto;
  min-width: 140rpx;
  height: 56rpx;
  padding: 0 28rpx;
  background: transparent;
  color: #8e8e93;
  font-size: 24rpx;
  font-weight: 400;
  border: 1rpx solid #e0e0e0;
}

.save-btn-inactive[disabled] {
  opacity: 1;
}

/* 邀请码卡片 */
.invite-card {
  background: #1a1a1a;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.invite-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.invite-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.invite-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

.invite-code {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.invite-char {
  width: 64rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.10);
  border-radius: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-accent);
  font-variant-numeric: tabular-nums;
}

.invite-desc {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 提醒卡片 */
.reminder-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--color-border);
}

.reminder-info {
  display: flex;
  flex-direction: column;
}

.reminder-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.reminder-desc {
  font-size: 24rpx;
  color: #8e8e93;
}

.reminder-btn {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  background: #f5f5f5;
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.reminder-btn::after {
  border: none;
}

.reminder-btn-active {
  background: var(--color-danger);
  color: #ffffff;
}

/* 我的计划入口 */
.plan-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--color-border);
}

.plan-info {
  display: flex;
  flex-direction: column;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.plan-desc {
  font-size: 24rpx;
  color: #8e8e93;
}

.plan-arrow {
  font-size: 40rpx;
  color: #c7c7cc;
  line-height: 1;
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-count {
  font-size: 24rpx;
  color: #8e8e93;
}

/* 空状态 */
.empty-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 1rpx solid var(--color-border);
}

.empty-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 28rpx;
  line-height: 1.5;
}

.empty-btn {
  width: 280rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
  line-height: 1;
}

.empty-btn::after {
  border: none;
}

/* 伙伴列表 */
.partner-list {
  background: #ffffff;
  border-radius: var(--radius-card);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  margin-bottom: 32rpx;
}

.partner-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.partner-item:last-child {
  border-bottom: none;
}

.partner-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.partner-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #8e8e93;
}

.partner-name {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
}

.remove-btn-wrap {
  flex-shrink: 0;
}

.remove-btn {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  background: rgba(163, 45, 45, 0.10);
  color: var(--color-danger);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 26rpx;
  border: none;
}

.remove-btn::after {
  border: none;
}

/* 底部操作 */
.action-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-btn,
.secondary-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  line-height: 1;
}

.primary-btn {
  background: #1a1a1a;
  color: #ffffff;
}

.secondary-btn {
  background: #ffffff;
  color: #1a1a1a;
}

.primary-btn::after,
.secondary-btn::after {
  border: none;
}