.container {
  padding: 0 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 88rpx);
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

.header {
  padding: 32rpx 0;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #8e8e93;
  margin-top: 8rpx;
}

/* 加载 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1a1a1a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #8e8e93;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #c7c7cc;
}

/* 计划列表 */
.plan-list {
  margin-top: 16rpx;
}

.plan-card {
  background: #ffffff;
  border-radius: var(--radius-card);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.plan-card-default {
  border: 1rpx solid var(--color-accent);
}

.plan-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 20rpx;
}

.plan-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 40%;
  overflow: hidden;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan-default-tag {
  font-size: 18rpx;
  color: var(--color-accent);
  border: 1rpx solid var(--color-accent);
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 2rpx 10rpx;
}

.plan-header-right {
  display: flex;
  align-items: center;
  gap: 32rpx;
  flex-shrink: 0;
}

.btn-edit,
.btn-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: 44rpx;
  padding: 4rpx 14rpx;
  background: transparent;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 22rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.btn-edit {
  color: #1a1a1a;
  border: 1rpx solid #c7c7cc;
}

.btn-delete {
  color: #8e8e93;
  border: 1rpx solid #c7c7cc;
}

.subject-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.subject-tag {
  font-size: 24rpx;
  color: #5a5a5a;
  background: #f5f5f5;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  z-index: 100;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 56rpx;
  padding-right: 72rpx;
}

.modal-close {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  color: #8e8e93;
  font-size: 40rpx;
  line-height: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}

.modal-close:active {
  opacity: 0.6;
}

.modal-body {
  padding: 32rpx;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.form-label-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-hint {
  font-size: 22rpx;
  color: #8e8e93;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.subject-input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.subject-input {
  flex: 1;
}

.subject-delete-btn {
  width: auto;
  height: 64rpx;
  padding: 0 20rpx;
  background: transparent;
  color: var(--color-danger);
  font-size: 24rpx;
  border: 1rpx solid var(--color-danger);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subject-delete-btn::after {
  border: none;
}

.add-subject-btn {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  color: #1a1a1a;
  font-size: 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.add-subject-btn::after {
  border: none;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  background: #f5f5f5;
  color: #1a1a1a;
}

.modal-btn-confirm {
  background: #1a1a1a;
  color: #ffffff;
}
