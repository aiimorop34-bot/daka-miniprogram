.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f5f5;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8e8e93;
  margin-bottom: 16rpx;
  margin-top: 24rpx;
}

.section-title:first-child {
  margin-top: 0;
}

/* 邀请码展示 */
.code-card {
  background: #1a1a1a;
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.code-display {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.code-char {
  width: 72rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.10);
  border-radius: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #34c759;
  font-variant-numeric: tabular-nums;
}

.code-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 分享按钮 */
.share-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  line-height: 1;
  margin-bottom: 32rpx;
}

.share-btn::after {
  border: none;
}

/* 输入框 */
.input-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.code-input {
  width: 100%;
  height: 64rpx;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  text-align: center;
  color: #1a1a1a;
}

/* 添加按钮 */
.add-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  line-height: 1;
  letter-spacing: 1rpx;
}

.add-btn::after {
  border: none;
}

/* 提示 */
.hint {
  margin-top: 24rpx;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: #c7c7cc;
  line-height: 1.5;
}